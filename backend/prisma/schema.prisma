datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Marketplace {
  WILDBERRIES
  OZON
}

enum TransactionType {
  SALE
  COMMISSION
  LOGISTICS
  STORAGE
  PENALTY
  ADJUSTMENT
  PAYOUT
  OTHER
}

enum TransactionStatus {
  PENDING
  PROCESSED
  ACCRUED
  PAID
  CANCELLED
}

// Immutable Ledger pattern (Section 12) - Rows should not be updated. 
// Any corrections/adjustments are added as new transactions with matching order_id (e.g. srid)
model Transaction {
  id             String            @id @default(uuid())
  transaction_id String            @unique // ID from the marketplace API
  marketplace    Marketplace
  type           TransactionType
  subtype        String?
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("RUB")
  sku            String?
  order_id       String?           // For Wildberries this is srid
  operation_date DateTime
  accrual_date   DateTime?
  payout_date    DateTime?
  status         TransactionStatus @default(PENDING)
  
  createdAt      DateTime          @default(now()) // No updatedAt in an Immutable Ledger

  @@index([order_id])
  @@index([marketplace, operation_date])
}
